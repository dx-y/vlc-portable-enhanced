+            THEMIM->togglePlayPause();
+    } );
     show();
 }
 
+void VideoWidget::cancelClickToPause()
+{
+    if( clickToPauseTimer )
+        clickToPauseTimer->stop();
+}
+
 VideoWidget::~VideoWidget()
 {
     /* Ensure we are not leaking the video output. This would crash. */
     assert( !stable );
     assert( !p_window );
+    teardownMouseHook();
+}
+
+#ifdef _WIN32
+HHOOK      VideoWidget::g_mouseHook   = NULL;
+VideoWidget *VideoWidget::g_hookOwner = NULL;
+POINT      VideoWidget::g_clickPt     = { 0, 0 };
+bool       VideoWidget::g_dragging    = false;
+
+HWND VideoWidget::currentVideoHwnd() const
+{
+    if( !stable )
+        return NULL;
+    /* The video renders into stable's native child window; clicks land on
+     * either stable itself or its descendant "VLC video output" window. */
+    QWindow *window = stable->windowHandle();
+    if( !window )
+        return NULL;
+    return static_cast<HWND>( QGuiApplication::platformNativeInterface()
+        ->nativeResourceForWindow( "handle", window ) );
+}
+
+void VideoWidget::setupMouseHook()
+{
+    if( g_mouseHook )
+        return;
+    g_hookOwner = this;
+    g_dragging  = false;
+    g_mouseHook = SetWindowsHookEx( WH_MOUSE_LL, mouseLLHookProc,
+                                    GetModuleHandle( NULL ), 0 );
+    if( g_mouseHook )
+        msg_Dbg( p_intf, "single-click pause: low-level mouse hook installed" );
+    else
+        msg_Warn( p_intf, "single-click pause: failed to install mouse hook" );
+}
+
+void VideoWidget::teardownMouseHook()
+{
+    if( g_mouseHook )
+    {
+        UnhookWindowsHookEx( g_mouseHook );
+        g_mouseHook = NULL;
+    }
+    if( g_hookOwner == this )
+        g_hookOwner = NULL;
+}
+
+LRESULT CALLBACK VideoWidget::mouseLLHookProc( int nCode, WPARAM wParam,
+                                               LPARAM lParam )
+{
+    if( nCode == HC_ACTION && g_hookOwner )
+    {
+        MSLLHOOKSTRUCT *pms = reinterpret_cast<MSLLHOOKSTRUCT*>( lParam );
+        HWND vid  = g_hookOwner->currentVideoHwnd();
+        if( vid && vid != GetDesktopWindow() )
+        {
+            HWND target = ::WindowFromPoint( pms->pt );
+            /* single/double click or drag lands on the video window itself
+             * or one of its descendants (e.g. "VLC video output") */
+            bool bHit = ( target == vid || IsChild( vid, target ) );
+            if( bHit )
+            {
+                if( wParam == WM_LBUTTONDOWN )
+                {
+                    g_clickPt  = pms->pt;
+                    g_dragging = false;
+                    if( g_hookOwner->clickToPauseTimer )
+                        g_hookOwner->clickToPauseTimer->start();
+                }
+                else if( wParam == WM_LBUTTONDBLCLK )
+                {
+                    g_hookOwner->cancelClickToPause();
+                }
+                else if( wParam == WM_MOUSEMOVE )
+                {
+                    /* A drag should cancel the single-click pause */
+                    if( !g_dragging )
+                    {
+                        int dx = pms->pt.x - g_clickPt.x;
+                        int dy = pms->pt.y - g_clickPt.y;
+                        if( abs(dx) + abs(dy) > 5 )
+                        {
+                            g_dragging = true;
+                            g_hookOwner->cancelClickToPause();
+                        }
+                    }
+                }
+            }
+        }
+    }
+    return CallNextHookEx( NULL, nCode, wParam, lParam );
 }
+#endif
 

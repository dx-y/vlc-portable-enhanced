     qApp->installNativeEventFilter(this);
+    /* Single click toggles play/pause; cancelled by double click or drag */
+    clickToPauseTimer = new QTimer( this );
+    clickToPauseTimer->setSingleShot( true );
+    clickToPauseTimer->setInterval( 250 );
+    connect( clickToPauseTimer, &QTimer::timeout, this, [this]() {
